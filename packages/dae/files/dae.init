#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/dae
CONF=/etc/dae/config.dae

start_service() {
	[ -f "$CONF" ] || return 1
	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
